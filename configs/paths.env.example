# Copy to `.env` or set these variables in the Kaggle/session configuration.
# All values are intentionally placeholders: never commit local or private paths.

# Root containing `page_multitask/{train,valid,test}.jsonl` and `images/`.
HWVLM_DATA_ROOT=/absolute/path/to/mthtr

# Offline model bundle. The Python runtime has a Kaggle-compatible default only
# for backward compatibility; set this explicitly for every reproducible run.
HWVLM_OFFLINE_BUNDLE_ROOT=/absolute/path/to/offline_bundle
HWVLM_MODEL_NAME=/absolute/path/to/Qwen3.5-0.8B-Base

# Exact dense checkpoint directory. It must contain CHECKPOINT_COMPLETE,
# checkpoint_manifest.json, metadata.json, and full_model_state.pt.
HWVLM_DENSE_INIT_CHECKPOINT=/absolute/path/to/dense/checkpoints/step_xxxxxx_cer_xx.xxxx

# Writable root for checkpoints, predictions, metrics, and figures.
HWVLM_OUTPUT_ROOT=/absolute/path/to/writable/outputs
